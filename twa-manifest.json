{
  "packageId": "studio.littleelsewhere.soundscript",
  "host": "soundscript-app.pages.dev",
  "name": "SoundScript — Trascrivi i vocali in un tap",
  "launcherName": "SoundScript",
  "display": "standalone",
  "orientation": "portrait-primary",
  "themeColor": "#4f46e5",
  "themeColorDark": "#4f46e5",
  "navigationColor": "#f8fafc",
  "navigationColorDark": "#f8fafc",
  "navigationDividerColor": "#f8fafc",
  "navigationDividerColorDark": "#f8fafc",
  "backgroundColor": "#f8fafc",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://soundscript-app.pages.dev/icons/icon-512.png",
  "maskableIconUrl": "https://soundscript-app.pages.dev/icons/icon-maskable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "android"
  },
  "appVersionName": "1.4.0",
  "appVersionCode": 2,
  "shortcuts": [
    {
      "name": "Nuova trascrizione",
      "shortName": "Nuova",
      "url": "https://soundscript-app.pages.dev/?action=new",
      "chosenIconUrl": "https://soundscript-app.pages.dev/icons/shortcut-new.png"
    },
    {
      "name": "Cronologia",
      "shortName": "Cronologia",
      "url": "https://soundscript-app.pages.dev/?action=history",
      "chosenIconUrl": "https://soundscript-app.pages.dev/icons/shortcut-history.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://soundscript-app.pages.dev/manifest.json",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://soundscript-app.pages.dev/",
  "minSdkVersion": 21,
  "shareTarget": {
    "action": "/share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".ogg",
            ".opus",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac"
          ]
        }
      ]
    }
  },
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": []
}
